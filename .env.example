# Copy to .env and fill in. Never commit .env.

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Leave unset to use local SQLite. With `docker compose up -d db`:
# DATABASE_URL=postgres://tgcg:tgcg@localhost:5432/tgcg

# Production only
# CORS_ALLOWED_ORIGINS=https://app.example.org
# CSRF_TRUSTED_ORIGINS=https://api.example.org

# Optional tuning
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# API_THROTTLE_LOGIN=10/min
# LOG_LEVEL=INFO

# SMS for phone verification codes. "console" prints codes to the log (dev only).
# SMS_BACKEND=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=TGCG

# Reading PVC photos sent from browsers (docs/pvc-reading.md). With a Google Cloud
# Vision key the photo goes to Google; without one, Tesseract is used if installed.
# GOOGLE_VISION_API_KEY=
# TESSERACT_CMD=tesseract

# Joining by USSD (docs/ussd-registration.md). Leave the token empty to keep USSD off.
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# USSD_CALLBACK_TOKEN=
# USSD_SERVICE_CODE=*384*1234#
